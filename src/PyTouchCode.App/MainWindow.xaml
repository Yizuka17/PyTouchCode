<Window x:Class="PyTouchCode.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:PyTouchCode.App">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Padding="16,0,150,0" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image x:Name="AppLogo" Source="ms-appx:///Assets/Logo44.png" Width="24" Height="24"/><TextBlock Grid.Column="1" Text="PyTouchCode" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <TextBlock x:Name="WorkspaceTitle" Grid.Column="2" Text="{x:Bind ViewModel.WorkspaceLabel, Mode=OneWay}" FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </Grid>
  <Grid x:Name="CommandRow" Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="4,0,8,4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <MenuBar x:Name="MainMenu">
    <MenuBarItem Title="文件">
     <MenuFlyoutItem Text="新建文件" Tag="new" Click="MenuAction" KeyboardAcceleratorTextOverride="Ctrl+N"/>
     <MenuFlyoutItem Text="打开文件…" Tag="open" Click="MenuAction" KeyboardAcceleratorTextOverride="Ctrl+O"/>
     <MenuFlyoutItem Text="打开文件夹…" Tag="folder" Click="MenuAction"/><MenuFlyoutSubItem x:Name="RecentMenu" Text="最近打开"/>
     <MenuFlyoutSeparator/>
     <MenuFlyoutItem Text="保存" Tag="save" Click="MenuAction" KeyboardAcceleratorTextOverride="Ctrl+S"/>
     <MenuFlyoutItem Text="另存为…" Tag="saveas" Click="MenuAction" KeyboardAcceleratorTextOverride="Ctrl+Shift+S"/>
     <MenuFlyoutItem Text="全部保存" Tag="saveall" Click="MenuAction"/><MenuFlyoutItem Text="从磁盘重新加载" Tag="reload" Click="MenuAction"/>
     <MenuFlyoutSubItem Text="保存编码"><MenuFlyoutItem Text="UTF-8" Tag="utf8" Click="MenuAction"/><MenuFlyoutItem Text="UTF-8 BOM" Tag="utf8bom" Click="MenuAction"/><MenuFlyoutItem Text="UTF-16 LE" Tag="utf16" Click="MenuAction"/><MenuFlyoutItem Text="GB18030" Tag="gb18030" Click="MenuAction"/></MenuFlyoutSubItem>
     <MenuFlyoutSubItem Text="换行符"><MenuFlyoutItem Text="LF" Tag="lf" Click="MenuAction"/><MenuFlyoutItem Text="CRLF" Tag="crlf" Click="MenuAction"/></MenuFlyoutSubItem>
     <MenuFlyoutSeparator/><MenuFlyoutItem Text="关闭标签页" Tag="close" Click="MenuAction" KeyboardAcceleratorTextOverride="Ctrl+W"/>
    </MenuBarItem>
    <MenuBarItem Title="编辑">
     <MenuFlyoutItem Text="撤销" Tag="undo" Click="MenuAction"/><MenuFlyoutItem Text="重做" Tag="redo" Click="MenuAction"/>
     <MenuFlyoutSeparator/><MenuFlyoutItem Text="剪切" Tag="cut" Click="MenuAction"/><MenuFlyoutItem Text="复制" Tag="copy" Click="MenuAction"/><MenuFlyoutItem Text="粘贴" Tag="paste" Click="MenuAction"/><MenuFlyoutItem Text="全选" Tag="selectall" Click="MenuAction"/>
     <MenuFlyoutSeparator/><MenuFlyoutItem Text="查找 / 替换…" Tag="find" Click="MenuAction" KeyboardAcceleratorTextOverride="Ctrl+F"/>
     <MenuFlyoutItem Text="切换行注释" Tag="comment" Click="MenuAction" KeyboardAcceleratorTextOverride="Ctrl+/"/>
     <MenuFlyoutItem Text="格式化文档" Tag="format" Click="MenuAction"/><MenuFlyoutItem Text="请求代码补全" Tag="complete" Click="MenuAction" KeyboardAcceleratorTextOverride="Ctrl+Space"/>
    </MenuBarItem>
    <MenuBarItem Title="视图">
     <MenuFlyoutItem Text="显示 / 隐藏侧边栏" Tag="sidebar" Click="MenuAction"/><MenuFlyoutItem Text="显示 / 隐藏输出面板" Tag="panel" Click="MenuAction"/><MenuFlyoutItem Text="显示 / 隐藏状态栏" Tag="statusbar" Click="MenuAction"/>
     <MenuFlyoutItem Text="自动换行" Tag="wrap" Click="MenuAction"/><MenuFlyoutItem Text="放大字体" Tag="zoomIn" Click="MenuAction"/><MenuFlyoutItem Text="缩小字体" Tag="zoomOut" Click="MenuAction"/>
     <MenuFlyoutItem Text="专注模式" Tag="focus" Click="MenuAction"/><MenuFlyoutItem Text="全屏" Tag="fullscreen" Click="MenuAction"/>
     <MenuFlyoutSubItem Text="主题"><MenuFlyoutItem Text="跟随系统" Tag="System" Click="MenuAction"/><MenuFlyoutItem Text="深色" Tag="Dark" Click="MenuAction"/><MenuFlyoutItem Text="浅色" Tag="Light" Click="MenuAction"/></MenuFlyoutSubItem>
    </MenuBarItem>
    <MenuBarItem Title="运行">
     <MenuFlyoutItem Text="运行当前文件" Tag="run" Click="MenuAction" KeyboardAcceleratorTextOverride="F5"/><MenuFlyoutItem Text="停止" Tag="stop" Click="MenuAction" KeyboardAcceleratorTextOverride="Shift+F5"/><MenuFlyoutItem Text="重新运行" Tag="rerun" Click="MenuAction"/>
     <MenuFlyoutSeparator/><MenuFlyoutItem Text="开始调试" Tag="debug" Click="MenuAction" KeyboardAcceleratorTextOverride="F6"/><MenuFlyoutItem Text="切换断点" Tag="breakpoint" Click="MenuAction" KeyboardAcceleratorTextOverride="F9"/>
     <MenuFlyoutItem Text="继续" Tag="continue" Click="MenuAction"/><MenuFlyoutItem Text="单步跳过" Tag="next" Click="MenuAction" KeyboardAcceleratorTextOverride="F10"/><MenuFlyoutItem Text="单步进入" Tag="stepIn" Click="MenuAction" KeyboardAcceleratorTextOverride="F11"/><MenuFlyoutItem Text="单步跳出" Tag="stepOut" Click="MenuAction"/>
     <MenuFlyoutSeparator/><MenuFlyoutItem Text="选择 Python 环境…" Tag="environment" Click="MenuAction"/>
    </MenuBarItem>
    <MenuBarItem Title="终端"><MenuFlyoutItem Text="启动 Shell" Tag="shell" Click="MenuAction"/><MenuFlyoutItem Text="启动 Python REPL" Tag="repl" Click="MenuAction"/><MenuFlyoutItem Text="关闭当前会话" Tag="closeterminal" Click="MenuAction"/><MenuFlyoutItem Text="清空输出" Tag="clear" Click="MenuAction"/></MenuBarItem>
    <MenuBarItem Title="设备"><MenuFlyoutItem Text="MicroPython 设备管理…" Tag="devices" Click="MenuAction"/></MenuBarItem>
    <MenuBarItem Title="选项"><MenuFlyoutItem Text="设置…" Tag="settings" Click="MenuAction"/><MenuFlyoutItem Text="环境与在线更新…" Tag="updates" Click="MenuAction"/></MenuBarItem>
   </MenuBar>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
    <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" Tag="run" Click="MenuAction" ToolTipService.ToolTip="运行当前文件 (F5)" MinHeight="36"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="运行"/></StackPanel></Button>
    <Button x:Name="StopButton" Tag="stop" Click="MenuAction" ToolTipService.ToolTip="停止运行 / 调试" AutomationProperties.Name="停止运行" MinWidth="40" MinHeight="36"></Button>
    <Button x:Name="SettingsButton" Tag="settings" Click="MenuAction" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置" MinWidth="40" MinHeight="36"></Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" x:Name="WorkspaceGrid">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarWidth" Width="240" MinWidth="0"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid x:Name="Sidebar" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" Padding="10,4,6,8">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <NavigationView Height="48" x:Name="SidebarNavigation" CompactPaneLength="0" OpenPaneLength="0" IsPaneOpen="False" IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False" SelectionChanged="SidebarNavigationChanged">
     <NavigationView.MenuItems><NavigationViewItem Content="文件" Tag="files" IsSelected="True"/><NavigationViewItem Content="调试" Tag="debug"/></NavigationView.MenuItems>
    </NavigationView>
     <Grid x:Name="SidebarPages" Grid.Row="1">
     <Grid x:Name="FilesSidebarPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="打开文件夹" HorizontalAlignment="Stretch" Tag="folder" Click="MenuAction"/><Button x:Name="RefreshFilesButton" Grid.Column="1" Tag="refresh" Click="MenuAction" ToolTipService.ToolTip="刷新文件树" AutomationProperties.Name="刷新文件树"></Button></Grid>
      <Grid x:Name="FileTreeHost" Grid.Row="1">
      <TreeView x:Name="FileTree" SelectionChanged="FileTreeSelectionChanged" LayoutUpdated="FileTreeLayoutUpdated" SelectionMode="Single" ItemInvoked="FileInvoked" Expanding="FileExpanding" Collapsed="FileCollapsed" ContextRequested="FileTreeContextRequested">
       <!-- A TreeViewNode stores FileTreeEntry data, never a shared UIElement.
            WinUI creates/recycles the visual row from this template. -->
       <TreeView.Resources>
        <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent"/>
        <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPressed" Color="Transparent"/>
       </TreeView.Resources>
       <TreeView.ItemTemplate>
        <DataTemplate x:DataType="TreeViewNode">
         <Grid Tag="{x:Bind}" ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind ((local:FileTreeEntry)Content).Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Width="20" Height="20" Source="{x:Bind ((local:FileTreeEntry)Content).IconSource, Mode=OneWay}"/>
          <TextBlock Grid.Column="1" Text="{x:Bind ((local:FileTreeEntry)Content).Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
         </Grid>
        </DataTemplate>
       </TreeView.ItemTemplate>
      </TreeView>
      <Border x:Name="FileSelectionIndicator" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/></Style></Border.Style></Border>
      </Grid>
     </Grid>
     <Grid x:Name="DebugSidebarPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Spacing="8"><TextBlock x:Name="DebugState" Text="尚未启动调试" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="4"><Button Content="继续" Tag="continue" Click="MenuAction"/><Button Content="跳过" Tag="next" Click="MenuAction"/><Button Content="进入" Tag="stepIn" Click="MenuAction"/></StackPanel></StackPanel>
      <TreeView x:Name="VariablesTree" Grid.Row="1" Margin="0,12,0,0" Expanding="VariableExpanding"/>
     </Grid>
    </Grid></Grid>
   </Grid>
   <Border Grid.Column="1" Background="Transparent" ManipulationMode="TranslateX" ManipulationDelta="SidebarResize" ToolTipService.ToolTip="拖动调整侧边栏宽度"/>
   <Grid Grid.Column="2" x:Name="EditorWorkspace">
    <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100"/><RowDefinition x:Name="PanelGripHeight" Height="6"/><RowDefinition x:Name="PanelHeight" Height="240" MinHeight="0"/></Grid.RowDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational"/>
     <TabView x:Name="Tabs" Grid.Row="1" Height="48" AddTabButtonClick="NewTabClicked" TabCloseRequested="TabCloseRequested" SelectionChanged="TabSelectionChanged" TabWidthMode="SizeToContent"/>
     <Grid x:Name="EditorHost" Grid.Row="2"/>
    </Grid>
    <Border Grid.Row="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" ManipulationMode="TranslateY" ManipulationDelta="PanelResize" ToolTipService.ToolTip="拖动调整输出高度"/>
    <Grid Grid.Row="2" x:Name="OutputPanel" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8,4,8,6" RowSpacing="4">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="OutputChannel" SelectedIndex="0" SelectionChanged="ChannelChanged" MinWidth="148"><x:String>运行输出</x:String><x:String>Shell</x:String><x:String>Python REPL</x:String><x:String>设备 REPL</x:String></ComboBox>
      <TextBlock x:Name="SessionStatus" Grid.Column="1" Margin="12,0" Text="{x:Bind ViewModel.SessionStatus, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"><Button Content="启动" Tag="startchannel" Click="MenuAction"/><Button Content="清空" Tag="clear" Click="MenuAction"/><Button x:Name="CollapseOutputButton" Tag="panel" Click="MenuAction" ToolTipService.ToolTip="收起输出" AutomationProperties.Name="收起输出"></Button></StackPanel>
     </Grid>
     <Grid x:Name="OutputHost" Grid.Row="1"/>
    </Grid>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" x:Name="StatusBar" Padding="12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="InterpreterButton" Content="{x:Bind ViewModel.InterpreterLabel, Mode=OneWay}" Tag="environment" Click="MenuAction" FontSize="12" Padding="4,0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left" MaxWidth="600"/>
   <TextBlock x:Name="PositionStatus" Grid.Column="1" Text="行 1，列 1" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
   <TextBlock x:Name="EncodingStatus" Grid.Column="2" Text="UTF-8 LF 4 空格" FontSize="12" VerticalAlignment="Center"/>
  </Grid>
 </Grid>
</Window>


